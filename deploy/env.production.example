# SonusLabs production env — copy to .env.production on the Pi and fill the keys.
# systemd loads this (EnvironmentFile). NEVER commit the filled version.

# ── Required ───────────────────────────────────────────────────────────────
SARVAM_API_KEY=          # your Sarvam key (STT + LLM + TTS)
OPENROUTER_API_KEY=      # for live web search + India metal rates (perplexity/sonar)

# ── Voice / behaviour ──────────────────────────────────────────────────────
SARVAM_TTS_VOICE=neha
DEFAULT_LANGUAGE=en-IN
GREETING_TEXT=Hi, thanks for calling. How can I help you today?
BARGEIN_INSTANT_PAUSE=true
ANSWER_DELAY_MS=2000

# ── Data (the clean prod set: only the sonuslabs demo agent, fresh call db) ─
AGENTS_FILE=data/agents.json
CALLS_DB_PATH=data/prod_calls.db
AGENTS_DB_PATH=data/prod_agents.db

# ── Public URL + demo cap ──────────────────────────────────────────────────
PUBLIC_URL=https://sonuslabs.online
WEB_CALL_MAX_SECONDS=180        # 3-min cap on the public demo orb (0 = no cap)
MAX_CONCURRENT_SESSIONS=20      # Pi has finite CPU; reject beyond this

# ── Phone (Telnyx) — OPTIONAL. The web demo works without these. ───────────
# Fill these only when you wire a real phone number; then point the Telnyx app
# webhook at https://sonuslabs.online/webhook/telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
MAIN_AGENT_NUMBER=              # e.g. +15572046319
TESTER_FROM_NUMBER=            # e.g. +18722698117
