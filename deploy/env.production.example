# SonusLabs production env — copy to .env.production on the Pi and fill the keys.
# systemd loads this (EnvironmentFile). NEVER commit the filled version.
# IMPORTANT: no inline "# comments" after a value — systemd keeps them as part
# of the value (breaks int fields). Keep comments on their own lines.

# Required
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Voice / behaviour
SARVAM_TTS_VOICE=neha
DEFAULT_LANGUAGE=en-IN
GREETING_TEXT=Hi, thanks for calling. How can I help you today?
BARGEIN_INSTANT_PAUSE=true
ANSWER_DELAY_MS=2000

# Data (clean prod set: only the sonuslabs demo agent, fresh call db)
AGENTS_FILE=data/agents.json
CALLS_DB_PATH=data/prod_calls.db
AGENTS_DB_PATH=data/prod_agents.db

# Public URL
PUBLIC_URL=https://sonuslabs.online

# 3-min cap on the public demo orb (0 = no cap)
WEB_CALL_MAX_SECONDS=180

# Pi has finite CPU; reject new media streams beyond this
MAX_CONCURRENT_SESSIONS=20

# Phone (Telnyx) — OPTIONAL. The web demo works without these.
# Fill only when wiring a real number; then point the Telnyx app webhook at
# https://sonuslabs.online/webhook/telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
MAIN_AGENT_NUMBER=
TESTER_FROM_NUMBER=
# REQUIRED whenever TELNYX_API_KEY is set: the Ed25519 public key from the
# Telnyx portal. Without it inbound webhooks are NOT signature-verified and
# anyone who finds the URL can spoof call events.
TELNYX_PUBLIC_KEY=
# Shared secret for the server-to-server /outbound API (x-api-key header).
# Empty = /outbound is OPEN. Set it whenever Telnyx creds are configured.
OUTBOUND_API_KEY=

# Legacy-mode admin key: gates /agents CRUD when accounts mode is OFF.
# Empty + legacy mode = agent CRUD is publicly writable. ALWAYS set one:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ─── ACCOUNTS MODE (Phase 4: auth + workspaces + billing) — OPTIONAL ───
# Leave DATABASE_URL empty for legacy mode (current prod behavior).
# Setting it flips the app to accounts mode: Postgres storage, Google sign-in,
# tenant-scoped console, prepaid credits. Requires Postgres on the Pi.
DATABASE_URL=
# Google OAuth web client. Redirect URI to whitelist:
# https://sonuslabs.online/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# NEVER enable in production (local-dev sign-in bypass).
DEV_LOGIN_ENABLED=false
# Platform operators: these signed-in emails see /admin (full monitor).
# e.g. ADMIN_EMAILS=you@company.com,cofounder@company.com
ADMIN_EMAILS=
# Prod is single-origin (backend serves the frontend) so CORS can stay empty;
# set only if a separate frontend origin ever calls this API.
CORS_ALLOW_ORIGINS=
# Billing: 300 = ₹3/min, billed per second. 15 free minutes at signup.
RATE_PAISE_PER_MIN=300
TRIAL_MINUTES=15
# Razorpay (credit top-ups). Empty = payments disabled ("coming soon").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
