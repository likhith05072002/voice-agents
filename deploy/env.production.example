# SonusLabs production env — copy to .env.production on the Pi and fill the keys.
# systemd loads this (EnvironmentFile). NEVER commit the filled version.
# IMPORTANT: no inline "# comments" after a value — systemd keeps them as part
# of the value (breaks int fields). Keep comments on their own lines.

# Required
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Voice / behaviour
SARVAM_TTS_VOICE=neha
DEFAULT_LANGUAGE=en-IN
GREETING_TEXT=Hi, thanks for calling. How can I help you today?
BARGEIN_INSTANT_PAUSE=true
ANSWER_DELAY_MS=2000

# Data (clean prod set: only the sonuslabs demo agent, fresh call db)
AGENTS_FILE=data/agents.json
CALLS_DB_PATH=data/prod_calls.db
AGENTS_DB_PATH=data/prod_agents.db

# Public URL
PUBLIC_URL=https://sonuslabs.online

# 3-min cap on the public demo orb (0 = no cap)
WEB_CALL_MAX_SECONDS=180

# Pi has finite CPU; reject new media streams beyond this
MAX_CONCURRENT_SESSIONS=20

# Phone (Telnyx) — OPTIONAL. The web demo works without these.
# Fill only when wiring a real number; then point the Telnyx app webhook at
# https://sonuslabs.online/webhook/telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
MAIN_AGENT_NUMBER=
TESTER_FROM_NUMBER=
