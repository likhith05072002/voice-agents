# Deploy scripts + configs MUST be LF — they run on the Raspberry Pi (Linux).
# CRLF would break the bash shebang ("\r: bad interpreter") and confuse
# systemd/Caddy/cloudflared parsers.
*.sh            text eol=lf
deploy/**       text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Caddyfile       text eol=lf
