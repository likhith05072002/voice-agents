# ─── Sarvam AI (required) ───
SARVAM_API_KEY=your-sarvam-key

# ─── Telephony: Telnyx ───
TELNYX_API_KEY=your-telnyx-key
# Outbound calling (campaigns/reminders): Call Control connection id + caller ID.
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Protect the billable /outbound endpoint.
OUTBOUND_API_KEY=
MAX_OUTBOUND_PER_MIN=0
# Base HTTPS URL where this server is reachable (used to build the wss media URL).
PUBLIC_URL=https://your-host.example.com
# Telnyx webhook signing public key (base64 Ed25519). When set, webhooks are
# verified and rejected on a bad signature. Leave blank only for local dev.
TELNYX_PUBLIC_KEY=

# ─── Telephony: EnableX (optional, India) ───
ENABLEX_APP_ID=
ENABLEX_APP_KEY=

# ─── Multi-tenant ───
# JSON array of per-business agents (see data/agents.example.json). Empty -> one
# default agent built from the persona settings below.
AGENTS_FILE=
# Runtime agent CRUD (POST/PATCH/DELETE /agents): SQLite store + admin key.
AGENTS_DB_PATH=agents.db
ADMIN_API_KEY=

# ─── Models / language (default agent) ───
DEFAULT_LANGUAGE=te-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=anushka
SARVAM_LLM_MODEL=sarvam-30b

# Landing-page "call me" demo — DIALS REAL PHONES ON YOUR CARRIER ACCOUNT.
# Off unless set; every limit below is a spend ceiling. Keep the prefix
# allowlist tight (premium-rate ranges are where dial-fraud pays out).
DEMO_CALL_ENABLED=false
DEMO_CALL_ALLOWED_PREFIXES=+91,+1
DEMO_CALL_MAX_SECONDS=180
DEMO_CALL_WARN_SECONDS=15
DEMO_CALL_GLOBAL_HOURLY=20

# Inworld (English/Hindi voice cloning on the demo widget)
INWORLD_API_KEY=your-inworld-key
INWORLD_TTS_MODEL=inworld-tts-1.5-mini

# ElevenLabs (optional TTS provider on the private demo page)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Private demo page served at /demo when set (local dev only; keep absent in prod)
PRIVATE_DEMO_FILE=

# ─── Turn engine tunables ───
ENABLE_FILLERS=false
STT_BUFFER_MS=100
# VAD sensitivity: true = snappier barge-in but more false triggers in noise.
STT_HIGH_VAD_SENSITIVITY=true
# Reasoning OFF (empty -> JSON null) keeps TTFT ~340ms. Set low/medium/high to enable.
SARVAM_LLM_REASONING_EFFORT=

# ─── Barge-in ───
# After a caller blip ends with no transcript, resume in this long (anti-stutter).
BARGEIN_SPEECH_END_GRACE_MS=300

# ─── Inbound audio DSP ───
ENABLE_INPUT_DSP=true            # noise gate + AGC before STT
ENABLE_ECHO_CANCELLATION=false   # NLMS echo canceller (needs live delay tuning)
# Spectral noise suppression: +8dB SNR on steady noise (fan/street/hum), even
# under speech. Off until validated against live Sarvam STT accuracy.
ENABLE_NOISE_SUPPRESSION=false

# ─── Agent layer ───
ENABLE_TOOLS=false               # function calling (demo: gold price + shop hours)
ENABLE_RAG=false                 # inject shop-knowledge snippets per turn
ENABLE_SAFETY=true               # injection flagging + prompt-leak + moderation
ENABLE_LANGUAGE_SWITCH=true      # TTS language follows the caller

# ─── Turn-taking dial + limits ───
EAGERNESS=balanced               # cautious | balanced | eager
MAX_CONCURRENT_SESSIONS=100
MAX_TURNS_PER_MIN=0              # per-call turn cap (0 = off)

# ─── Session / silence ───
ENABLE_IDLE=true
IDLE_REPROMPT_MS=10000
IDLE_HANGUP_MS=30000

# ─── Semantic endpointing (opt-in; validate live before enabling) ───
ENABLE_SMART_ENDPOINTING=false
ENDPOINTING_CONTINUATION_MS=600

# ─── Persistence & analytics ───
ENABLE_PERSISTENCE=true
CALLS_DB_PATH=calls.db
ENABLE_CALL_SUMMARY=false        # post-call LLM summary + outcome + sentiment

# ─── Server ───
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=debug

# Optional LLM fallbacks (unused by default)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
